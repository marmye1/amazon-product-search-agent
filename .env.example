# 生产 Agent API 非敏感配置模板。复制为 .env 后填写本机值；不要提交 .env。
APP_VERSION=production
AGENT_VERSION=production
RETRIEVAL_METHOD=hybrid_rrf
SEARCH_CONFIG_PATH=config/search.yaml
DEFAULT_CHAT_TOP_K=5
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
HEALTH_TIMEOUT_SECONDS=2

# OpenSearch；本地默认值也可继续使用 search.yaml。
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_BASE_URL=https://127.0.0.1:9200
OPENSEARCH_VERIFY_SSL=false
HYBRID_INDEX_NAME=amazon_products_v4

# LM Studio OpenAI-compatible endpoints。
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen-local
QWEN_API_KEY=lm-studio
QWEN_TIMEOUT_SECONDS=180
QWEN_MAX_TOKENS=1200
QWEN_TEMPERATURE=0
QWEN_JSON_MODE=true
